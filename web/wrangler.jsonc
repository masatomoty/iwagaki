{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// viewer と生成済みアセットの配信。設計は docs/web_design.md §6、手順は docs/infra.md。
	//
	// 静的アセット（html / js / wasm / catalog / タイル / 3D Tiles / geojson）は Workers Assets、
	// COPC だけ Worker 経由で R2 から Range 配信する。Pages / Workers Assets の Range 挙動に
	// 依存せず 206 を保証するため（docs/web_design.md §6.1）。
	// 同一オリジンに揃えるのは PerformanceResourceTiming.transferSize が
	// クロスオリジンで 0 になるため（同 §8.3）。
	"name": "iwagaki-viewer",
	"main": "deploy/worker.js",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./dist",
		// 全リクエストを Worker 先行にする。理由は 2 つ:
		//   - 旧 *.workers.dev で来たアクセスを正規ドメインへ 301 で寄せる（deploy/worker.js）
		//   - COPC・潮位予測 API を「アセットが無いから落ちてきた」ではなく最初から Worker が処理する
		// COPC・潮位 API 以外は deploy/worker.js が env.ASSETS.fetch() で Workers Assets に
		// そのまま委譲するので、静的配信物の扱い（_headers・圧縮・キャッシュ）は変わらない。
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// raw LAS（将来）と COPC を同じバケットに置く。キー空間は URL パスと一致させる:
	//   data/pointcloud/*.copc.laz   配信対象（= https://<host>/data/pointcloud/...）
	//   raw/las/*                    将来のアップロード置き場（docs/web_design.md §7）
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "iwagaki-assets"
		},
		{
			"bucket_name": "iwagaki-assets",
			"binding": "iwagaki_assets",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	// 独自ドメイン（Range も transferSize も同一オリジンのままで済む）。
	// custom_domain は wrangler が proxied DNS レコードとエッジ証明書まで作る。
	// oniyanma.jp は Cloudflare 上のゾーンである必要がある。
	"routes": [
		{ "pattern": "maizuru.oniyanma.jp", "custom_domain": true }
	],
	// workers.dev の URL は開けたままにする。deploy/worker.js が *.workers.dev への
	// アクセスを正規ドメインへ 301 で寄せるので、旧 URL のブックマーク・共有リンクが
	// 生き続ける。証明書発行待ちの退避先も兼ねる。完全に畳むなら false にする。
	"workers_dev": true
}